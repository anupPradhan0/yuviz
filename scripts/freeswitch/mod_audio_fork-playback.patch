+  switch_bool_t fork_playback_frame(switch_core_session_t *session, switch_media_bug_t *bug) {
+    private_t* tech_pvt = (private_t*) switch_core_media_bug_get_user_data(bug);
+    if (!tech_pvt || !tech_pvt->mutex || !tech_pvt->playback_buffer) return SWITCH_TRUE;
+
+    switch_frame_t *frame = switch_core_media_bug_get_write_replace_frame(bug);
+    if (!frame || !frame->data || frame->samples == 0) return SWITCH_TRUE;
+
+    switch_codec_implementation_t write_impl;
+    switch_core_session_get_write_impl(session, &write_impl);
+    const uint32_t out_rate = write_impl.actual_samples_per_second;
+    const uint32_t in_rate = tech_pvt->sampling;
+    const uint32_t out_samples = frame->samples;
+    int16_t *out = (int16_t *) frame->data;
+
+    switch_mutex_lock(tech_pvt->mutex);
+    const size_t avail = switch_buffer_inuse(tech_pvt->playback_buffer) & ~((size_t) 1);
+    if (avail == 0) {
+      // Nothing queued: leave the channel's own audio (silence while parked).
+      switch_mutex_unlock(tech_pvt->mutex);
+      return SWITCH_TRUE;
+    }
+
+    if (in_rate == out_rate) {
+      const size_t want = out_samples * sizeof(int16_t);
+      const size_t n = avail < want ? avail : want;
+      switch_buffer_read(tech_pvt->playback_buffer, out, n);
+      if (n < want) memset((uint8_t *) out + n, 0, want - n);
+    }
+    else {
+      if (!tech_pvt->playback_resampler || tech_pvt->playback_rate != out_rate) {
+        int err = 0;
+        if (tech_pvt->playback_resampler) speex_resampler_destroy(tech_pvt->playback_resampler);
+        tech_pvt->playback_resampler = speex_resampler_init(1, in_rate, out_rate, SWITCH_RESAMPLE_QUALITY, &err);
+        tech_pvt->playback_rate = out_rate;
+        if (0 != err) {
+          tech_pvt->playback_resampler = nullptr;
+          switch_mutex_unlock(tech_pvt->mutex);
+          return SWITCH_TRUE;
+        }
+      }
+      int16_t in[SWITCH_RECOMMENDED_BUFFER_SIZE / sizeof(int16_t)];
+      spx_uint32_t in_len = (spx_uint32_t) (((uint64_t) out_samples * in_rate) / out_rate);
+      if (in_len > sizeof(in) / sizeof(int16_t)) in_len = sizeof(in) / sizeof(int16_t);
+      const size_t want = in_len * sizeof(int16_t);
+      const size_t n = avail < want ? avail : want;
+      switch_buffer_read(tech_pvt->playback_buffer, in, n);
+      if (n < want) memset((uint8_t *) in + n, 0, want - n);
+      spx_uint32_t out_len = out_samples;
+      speex_resampler_process_int(tech_pvt->playback_resampler, 0, in, &in_len, out, &out_len);
+      if (out_len < out_samples) memset(out + out_len, 0, (out_samples - out_len) * sizeof(int16_t));
+    }
+    switch_mutex_unlock(tech_pvt->mutex);
+
+    switch_core_media_bug_set_write_replace_frame(bug, frame);
+    return SWITCH_TRUE;
+  }
+}
