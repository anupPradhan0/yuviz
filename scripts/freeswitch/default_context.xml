<!--
  Replaces FreeSWITCH's stock "default" context, a demo dialplan whose
  extensions reach other calls on the switch (779 eavesdrop all, 886 / *8 /
  **<ext> intercept, park/valet-park, conferences). Nothing on this platform
  routes calls here: transfers and originates bridge inline. Anything that
  lands here is refused.
  Installed as dialplan/default.xml by scripts/freeswitch/setup_macos.sh.
-->
<include>
  <context name="default">
    <extension name="deny_all">
      <condition field="destination_number" expression="^.*$">
        <action application="log" data="WARNING default context is disabled; refused ${destination_number}"/>
        <action application="hangup" data="CALL_REJECTED"/>
      </condition>
    </extension>
  </context>
</include>
