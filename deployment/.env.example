# ./dev.sh copies this to .env and fills the secrets. No hand-editing needed.

POSTGRES_USER=voiceai
POSTGRES_PASSWORD=voiceai
POSTGRES_DB=voiceai
# Host is the compose service name — every consumer is a container.
POSTGRES_DSN=postgresql://voiceai:voiceai@postgres:5432/voiceai
REDIS_URL=redis://redis:6379/0

# Set by dev.sh from USE_HOST_OLLAMA.
OLLAMA_BASE_URL=http://ollama:11434

CONFIG_SERVICE_EMAIL=conversation-service@internal.yuviz.ai
CONFIG_SERVICE_PASSWORD=
JWT_SECRET=

# Loopback by default — default credentials, and no auth on redis/ollama.
BIND_ADDR=127.0.0.1

# Read by both the conversation service and the seed; they must agree.
VOICEAI_STT_MODEL=small.en
# Written by deployment/sh/dev.sh from --no-stt / --no-tts. 0 keeps that
# model out of Conversation Service's startup warm-up.
VOICEAI_ENABLE_STT=1
VOICEAI_ENABLE_TTS=1

# Host ports — change any that collide.
ADMIN_UI_PORT=3000
CONFIG_PORT=8000
KNOWLEDGE_PORT=8100
WEBCALL_PORT=8300
CONVERSATION_PORT=50051
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# Mirror for the spaCy model if github.com is unreachable. Rebuild after changing.
SPACY_MODEL_URL=
