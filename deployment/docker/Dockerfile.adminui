# Dev mode (next dev, hot reload) — not a production build.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app/admin-ui

COPY admin-ui/package.json admin-ui/pnpm-lock.yaml* ./
# sharp/unrs-resolver ship prebuilt binaries, so their ignored build scripts are
# harmless — but pnpm >=10 turns that warning into ERR_PNPM_IGNORED_BUILDS.
RUN pnpm install --frozen-lockfile --config.strictDepBuilds=false \
    || pnpm install --config.strictDepBuilds=false

COPY admin-ui/ ./

ENV NEXT_TELEMETRY_DISABLED=1

# 0.0.0.0, not localhost — otherwise the published port reaches nothing.
CMD ["pnpm", "dev", "--hostname", "0.0.0.0", "--port", "3000"]
