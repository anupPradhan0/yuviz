# Conversation Service — copy to .env and fill in, or `export` these
# directly. See docs/setup.md for the full walkthrough.

# Required. Postgres connection string — used for transcript recording.
POSTGRES_DSN=postgresql://youruser@localhost:5432/voiceai

# Optional — defaults to a local Redis on the standard port if unset.
REDIS_URL=redis://localhost:6379/0

# Required. Config Service's REST API — this process authenticates as a
# service account to resolve tenant/agent/provider config at call time
# (see libs/config_sdk). Create the account with
# scripts/create_service_account.py first (docs/setup.md §5) — never
# hardcode the real password here or commit it.
CONFIG_SERVICE_URL=http://localhost:8000
CONFIG_SERVICE_EMAIL=conversation-service@internal.yuviz.ai
CONFIG_SERVICE_PASSWORD=replace-with-the-password-you-picked

# Optional — only needed for RAG-backed agents (Knowledge Service).
KNOWLEDGE_SERVICE_URL=http://localhost:8100

# --- Cloud provider API keys (all optional) ---
# Only needed if you configure a tenant's provider_configs to use a cloud
# STT/LLM/TTS engine (Deepgram, Gemini, ElevenLabs, ...) instead of the
# local defaults (faster_whisper/ollama/kokoro). Each provider_config
# stores an api_key_ref like "env:DEEPGRAM_API_KEY" pointing at one of
# these — see services/conversation/secret_resolver.py. Uncomment and
# set only the ones you actually use.
# DEEPGRAM_API_KEY=
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
