# Config Service — copy to .env and fill in, or `export` these directly.
# See docs/setup.md for the full walkthrough.

# Required. Postgres connection string (services/config/db.py).
POSTGRES_DSN=postgresql://youruser@localhost:5432/voiceai

# Optional — defaults to a local Redis on the standard port if unset
# (services/config/cache.py).
REDIS_URL=redis://localhost:6379/0

# Optional but should be set to a real random value outside local dev —
# signs the JWTs this service issues. Falls back to an insecure dev-only
# default if unset (see services/config/app.py's JWT_SECRET).
JWT_SECRET=replace-with-a-real-random-secret
