# Knowledge Service — copy to .env and fill in, or `export` these directly.
# Optional overall: only needed if you're testing RAG-backed agents.
# See docs/setup.md for the full walkthrough.

# Required. Postgres connection string (pgvector-backed).
POSTGRES_DSN=postgresql://youruser@localhost:5432/voiceai

# Optional — defaults to a local Redis on the standard port if unset.
REDIS_URL=redis://localhost:6379/0

# Optional — where uploaded tenant documents are stored on disk. Defaults
# to ./data/knowledge_documents relative to wherever the process runs.
KNOWLEDGE_STORAGE_ROOT=./data/knowledge_documents
